---
import Layout from "../components/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Card from "../components/Card.astro";
import Badge from "../components/Badge.astro";
import Button from "../components/Button.astro";
import { profile, projectCategories, articles } from "../../data/site";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const skills = [
  ["Backend Development", ["Python", "JavaScript", "TypeScript", "FastAPI", "Pydantic", "REST APIs", "Swagger"]],
  ["Frontend & App Interfaces", ["React", "Next.js", "SvelteKit", "HTML5", "CSS3", "Tailwind CSS", "Streamlit"]],
  ["Workflow Automation", ["n8n", "Make", "Power Automate", "Google Apps Script", "OpenWorkflow"]],
  ["AI, LLM & Agent Development", ["Cohere", "LangChain", "LangGraph", "LlamaIndex", "RAG", "LLM API integration"]],
  ["Databases & Vector Stores", ["PostgreSQL", "MySQL", "SQLite", "Supabase", "pgvector", "Milvus", "Redis"]],
  ["CRM & Third-party Integrations", ["HubSpot", "WelcomeHome", "LineLeader", "Google Workspace", "Microsoft Graph API", "Zendesk", "Freshservice", "RingCentral"]],
  ["Testing & Security", ["End-to-end testing", "QA automation", "DAST", "Penetration testing"]],
  ["Cloud & Deployment", ["Docker", "Google Cloud", "Azure", "AWS", "Render", "Vercel"]],
];
const projects = projectCategories.flatMap((category) => category.items).slice(0, 3);
---
<Layout>
  <main>
    <section class="mx-auto max-w-6xl px-4 pb-16 pt-16 md:pb-24 md:pt-24"><div class="grid gap-10 md:grid-cols-[1.2fr_0.8fr] md:items-end"><div class="space-y-6"><div class="space-y-4"><h1 class="font-display max-w-4xl text-4xl font-semibold tracking-tight text-[#0B3B5E] md:text-6xl md:leading-[1.05]">I build efficient systems.</h1><p class="max-w-3xl text-lg leading-8 text-muted-foreground">{profile.shortBio}</p></div><div class="flex flex-wrap gap-3"><Button href={`${base}ai-agentic-ai-projects/`}>View Projects →</Button><Button href={`${base}articles/`}>Read articles</Button></div></div><Card title={profile.name} description={profile.role}><div class="flex flex-col items-start gap-2 text-sm"><a class="inline-flex items-center gap-2 text-[#2B7EA8] hover:text-[#0B3B5E]" href={`mailto:${profile.email}`}><span aria-hidden="true">✉</span>{profile.email}</a><a class="inline-flex items-center gap-2 text-[#2B7EA8] hover:text-[#0B3B5E]" href={profile.linkedin} target="_blank" rel="noreferrer"><span aria-hidden="true">in</span>LinkedIn</a><a class="inline-flex items-center gap-2 text-[#2B7EA8] hover:text-[#0B3B5E]" href={profile.github} target="_blank" rel="noreferrer"><span aria-hidden="true">GH</span>GitHub</a></div></Card></div></section>
    <section class="mx-auto max-w-6xl px-4 py-16"><SectionHeading eyebrow="Technical skills" title="Technical Skills" description="Here’s a look at the tools and platforms I use to build reliable automations, APIs, and AI systems." /><div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">{skills.map(([title, items]) => <Card title={title as string}><div class="flex flex-wrap gap-2">{(items as string[]).map((item) => <Badge>{item}</Badge>)}</div></Card>)}</div></section>
    <section class="mx-auto max-w-6xl px-4 py-16"><SectionHeading eyebrow="Selected work" title="AI/Agentic AI projects" description="Here are a few apps and systems I’ve built around AI interaction, information retrieval, and workflow automation." /><div class="mt-8 grid gap-6 md:grid-cols-3">{projects.map((project) => <Card title={project.name} description={project.summary}><div class="flex flex-wrap gap-2">{project.stack.map((item) => <Badge>{item}</Badge>)}</div><Button href={`${base}ai-agentic-ai-projects/`} variant="outline" class="mt-5 w-full">Open project →</Button></Card>)}</div></section>
    <section class="mx-auto max-w-6xl px-4 py-16"><SectionHeading eyebrow="Writing" title="Engineering articles" description="Selected articles focused on retrieval design, backend reliability, practical architecture, and workflow automation." /><div class="mt-8 grid gap-6 md:grid-cols-2">{articles.slice(0, 4).map((article) => <Card title={article.title} description={article.summary}><div class="flex flex-wrap gap-2">{article.tags.map((tag) => <Badge>{tag}</Badge>)}</div><Button href={article.href} variant="outline" class="mt-5">Read on Medium →</Button></Card>)}</div></section>
  </main>
</Layout>
