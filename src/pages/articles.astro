---
import Layout from "../components/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Card from "../components/Card.astro";
import Badge from "../components/Badge.astro";
import Button from "../components/Button.astro";
import { articles } from "../../data/site";
---
<Layout><main class="mx-auto max-w-6xl px-4 py-16 md:py-24"><SectionHeading eyebrow="Articles" title="Selected technical writing" description="Featured writing on retrieval quality, FastAPI architecture, error handling, backend pragmatism, realtime integrations, and workflow automation." /><div class="mt-10 grid gap-6 md:grid-cols-2">{articles.map((article) => <Card title={article.title} description={article.summary}><div class="flex flex-wrap gap-2">{article.tags.map((tag) => <Badge>{tag}</Badge>)}</div><Button href={article.href} variant="outline" class="mt-5">Read article →</Button></Card>)}</div></main></Layout>
