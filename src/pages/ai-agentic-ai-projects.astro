---
import Layout from "../components/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Card from "../components/Card.astro";
import Badge from "../components/Badge.astro";
import Button from "../components/Button.astro";
import { projectCategories } from "../../data/site";
---
<Layout><main class="mx-auto max-w-6xl px-4 py-16 md:py-24"><SectionHeading eyebrow="AI/Agentic AI Projects" title="AI &amp; Agentic Apps" description="Here are some of the AI applications and projects I’ve worked on, from Streamlit prototypes to full-stack TypeScript and Next.js builds." /><div class="mt-10 space-y-12">{projectCategories.map((category) => <section class="space-y-5"><h2 class="font-display text-2xl font-semibold tracking-tight text-[#0B3B5E]">{category.title}</h2><div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">{category.items.map((project) => <Card title={project.name} description={project.summary}><div class="space-y-4 text-sm leading-6 text-muted-foreground"><p><strong class="text-[#0B3B5E]">Problem:</strong> {project.problem}</p><p><strong class="text-[#0B3B5E]">What I built:</strong> {project.built}</p><p><strong class="text-[#0B3B5E]">Engineering note:</strong> {project.engineeringNote}</p></div><div class="mt-5 flex flex-wrap gap-2">{project.stack.map((item) => <Badge>{item}</Badge>)}</div><Button href={project.href} variant="outline" class="mt-5 w-full" target="_blank" rel="noreferrer">View project →</Button></Card>)}</div></section>)}</div></main></Layout>
