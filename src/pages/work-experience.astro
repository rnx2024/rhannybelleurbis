---
import Layout from "../components/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Card from "../components/Card.astro";
import { workExperience } from "../../data/site";
---
<Layout><main class="mx-auto max-w-6xl px-4 py-16 md:py-24"><SectionHeading eyebrow="Experience" title="Work experience" /><div class="mt-10 space-y-6">{workExperience.map((role) => <div class="border-l border-sky-200/70 pl-6"><div class="relative"><div class="absolute -left-[33px] top-7 h-3 w-3 rounded-full bg-[#87CEFA] ring-4 ring-white shadow-sm"></div><Card title={role.role} description={`${role.company} · ${role.period}`}><ul class="list-disc space-y-2 pl-5 text-sm leading-6 text-muted-foreground">{role.highlights.map((item) => <li>{item}</li>)}</ul></Card></div></div>)}</div></main></Layout>
