---
import { profile } from "../../data/site";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const nav = [
  { href: base, label: "Home" },
  { href: `${base}work-experience/`, label: "Work Experience" },
  { href: `${base}ai-agentic-ai-projects/`, label: "Projects" },
  { href: `${base}articles/`, label: "Articles" },
];
---
<header class="sticky top-0 z-40 border-b border-border/80 bg-background/80 backdrop-blur">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-4 md:flex-row md:items-center md:justify-between md:gap-6">
    <a href={base} class="group flex min-w-0 items-center gap-3">
      <img src={`${base}rnx-logo.png`} alt="RNX logo" width="52" height="52" class="h-[52px] w-[52px] rounded-2xl object-contain" />
      <div class="min-w-0"><div class="font-display text-2xl font-semibold tracking-wide text-[#87CEFA] md:text-3xl">{profile.name}</div><div class="truncate text-[10px] font-medium uppercase tracking-[0.12em] text-muted-foreground md:text-xs md:tracking-[0.18em]">{profile.role}</div></div>
    </a>
    <nav aria-label="Main navigation" class="flex w-full flex-wrap items-center justify-start gap-x-2 gap-y-2 text-sm text-[#0B3B5E] md:w-auto md:justify-end">
      {nav.map((item) => <a href={item.href} class="whitespace-nowrap rounded-full px-3 py-1.5 transition hover:bg-sky-100 hover:text-[#0B3B5E]">{item.label}</a>)}
    </nav>
  </div>
</header>
