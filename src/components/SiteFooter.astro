---
import { profile } from "../../data/site";
---
<footer class="border-t border-border/80"><div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10 text-sm text-muted-foreground md:flex-row md:items-center md:justify-between"><div><div class="font-display font-medium text-foreground">{profile.name}</div><div>{profile.role}</div></div><div class="flex flex-wrap items-center gap-4"><a href={`mailto:${profile.email}`} class="inline-flex items-center gap-2 text-[#2B7EA8] hover:text-[#0B3B5E]">✉ {profile.email}</a><a href={profile.linkedin} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 text-[#2B7EA8] hover:text-[#0B3B5E]">in LinkedIn</a><a href={profile.github} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 text-[#2B7EA8] hover:text-[#0B3B5E]">GH GitHub</a></div></div></footer>
