---
const { eyebrow, title, description } = Astro.props;
---
<div class="max-w-2xl space-y-3">{eyebrow && <div class="text-xs font-semibold uppercase tracking-[0.32em] text-[#0B3B5E]/70">{eyebrow}</div>}<h2 class="font-display text-3xl font-semibold tracking-tight text-[#0B3B5E] md:text-4xl">{title}</h2>{description && <p class="text-base leading-7 text-muted-foreground">{description}</p>}</div>
