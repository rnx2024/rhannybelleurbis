---
const { title, description, class: className = "" } = Astro.props;
---
<article class={`rounded-2xl border border-sky-200/70 bg-gradient-to-br from-sky-100 via-sky-50 to-blue-100 text-card-foreground shadow-soft ${className}`}><div class="flex flex-col space-y-1.5 p-6"><h3 class="font-display text-xl font-semibold tracking-tight text-[#0B3B5E]">{title}</h3>{description && <p class="text-sm text-muted-foreground">{description}</p>}</div><div class="p-6 pt-0"><slot /></div></article>
